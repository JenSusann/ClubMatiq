{
	"name": "clubmatiq",
	"version": "0.9.2",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"exceljs": {
			"uuid": "^11.1.1"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run tests/unit",
		"test:watch": "vitest tests/unit",
		"test:coverage": "vitest run tests/unit --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts --coverage",
		"coverage:merge": "node scripts/merge-coverage.mjs",
		"test:all": "npm run test:coverage && npm run test:integration && npm run coverage:merge",
		"db:init:dev": "node scripts/init-database.mjs --environment=dev",
		"db:init:demo": "node scripts/init-database.mjs --environment=demo",
		"db:init:prod": "node scripts/init-database.mjs --environment=prod",
		"db:schema:export": "node scripts/init-database.mjs --environment=prod --export",
		"db:backup:prod": "node scripts/backup-database.mjs prod",
		"db:backup:dev": "node scripts/backup-database.mjs dev",
		"db:backup:demo": "node scripts/backup-database.mjs demo",
		"db:restore:test": "node scripts/restore-database.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^7.0.0",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^5.1.1",
		"istanbul-lib-coverage": "^3.2.2",
		"istanbul-lib-report": "^3.0.1",
		"istanbul-reports": "^3.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"argon2": "^0.45.2",
		"cloudinary": "^2.11.0",
		"dotenv": "^18.0.10",
		"exceljs": "^4.4.0",
		"mongodb": "^7.8.0",
		"nodemailer": "^10.0.10",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.4"
	}
}
